rules_version = '2';

// FW Studio Workspace: who can see and change what.
// Paste this into Firebase: Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------
    function signedIn() { return request.auth != null; }
    function ownerEmail() { return "fwstudio786@gmail.com"; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function isAdmin() { return hasProfile() && me().role == "admin"; }
    function isEditor() { return hasProfile() && me().role == "editor"; }
    function isTeam() { return hasProfile() && (me().role == "admin" || me().role == "editor"); }
    function isClient() { return hasProfile() && me().role == "client"; }
    function validRole(r) { return r in ["admin", "editor", "client"]; }

    // ---------- people ----------
    // A profile can only be created by its own (verified) account: the owner email becomes
    // an admin, everyone else needs an invite and gets exactly the role on that invite.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeam());
      allow create: if signedIn() && request.auth.uid == uid && verified()
        && request.resource.data.email == myEmail()
        && (
          (myEmail() == ownerEmail() && request.resource.data.role == "admin")
          || (exists(invitePath())
              && request.resource.data.role == get(invitePath()).data.role
              && request.resource.data.get("clientId", "") == get(invitePath()).data.get("clientId", ""))
        );
      allow update: if (isAdmin() && validRole(request.resource.data.role))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]));
      allow delete: if isAdmin();
    }

    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && verified() && myEmail() == email);
      allow create, update: if isAdmin() && validRole(request.resource.data.role);
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isTeam() || (isClient() && me().clientId == clientId);
      allow write: if isAdmin();
    }

    // ---------- work ----------
    // Full task details (brief, notes, sheet): admins see all, editors only their own tasks.
    match /tasks/{taskId} {
      allow read: if isAdmin() || (isEditor() && resource.data.assignee == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isEditor() && resource.data.assignee == request.auth.uid
            && request.resource.data.assignee == resource.data.assignee
            && request.resource.data.client == resource.data.client);
    }

    // What the client sees (title, video link, message, status, history). A client can only
    // answer a video that is waiting for review, by adding exactly one decision of their own.
    match /reviews/{taskId} {
      allow read: if isAdmin()
        || (isEditor() && resource.data.assignee == request.auth.uid)
        || (isClient() && resource.data.client == me().clientId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isEditor() && resource.data.assignee == request.auth.uid
            && request.resource.data.assignee == resource.data.assignee
            && request.resource.data.client == resource.data.client)
        || (isClient() && resource.data.client == me().clientId
            && resource.data.status == "review"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "history", "updatedAt"])
            && request.resource.data.status in ["approved", "revision", "rejected"]
            && request.resource.data.history.size() == resource.data.history.size() + 1
            && request.resource.data.history[0:resource.data.history.size()] == resource.data.history
            && request.resource.data.history[resource.data.history.size()].by == "client"
            && request.resource.data.history[resource.data.history.size()].state == request.resource.data.status);

      // Comments on the video: anyone who can see the video can read them and add their own.
      match /comments/{commentId} {
        function rev() { return get(/databases/$(database)/documents/reviews/$(taskId)).data; }
        function canSee() {
          return isAdmin()
            || (isEditor() && rev().assignee == request.auth.uid)
            || (isClient() && rev().client == me().clientId);
        }
        allow read: if canSee();
        allow create: if canSee()
          && request.resource.data.keys().hasOnly(["text", "t", "v", "vid", "by", "uid", "name", "at", "parent", "done", "doneBy", "doneAt", "mis", "audio", "adur"])
          && request.resource.data.uid == request.auth.uid
          && ((isClient() && request.resource.data.by == "client") || (isTeam() && request.resource.data.by == "team"))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.done == false;
        // Anyone on the video can tick a comment done; only the author can change its text.
        allow update: if canSee()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["done", "doneBy", "doneAt", "text", "mis"])
          && (request.resource.data.text == resource.data.text || resource.data.uid == request.auth.uid);
        allow delete: if isAdmin() || (canSee() && resource.data.uid == request.auth.uid);
      }
    }

    // The final file link. The team can always see and set it; the client can only read it
    // once their video is approved.
    match /downloads/{taskId} {
      function rv() { return get(/databases/$(database)/documents/reviews/$(taskId)).data; }
      allow read: if isAdmin()
        || (isEditor() && rv().assignee == request.auth.uid)
        || (isClient() && rv().client == me().clientId && rv().status == "approved");
      allow create, update: if (isAdmin() || (isEditor() && rv().assignee == request.auth.uid))
        && request.resource.data.keys().hasOnly(["url", "updatedAt"])
        && request.resource.data.url is string && request.resource.data.url.size() <= 2000;
      allow delete: if isAdmin();
    }

    // Team-only documents and spreadsheets.
    match /docs/{docId} { allow read, write: if isTeam(); }
    match /sheets/{sheetId} { allow read, write: if isTeam(); }
  }
}
